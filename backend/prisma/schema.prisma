generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id        String   @id @default(uuid())
  name      String
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  issues   ImportIssue[]
}

model Section {
  id         String @id @default(uuid())
  templateId String
  name       String
  order      Int

  template    Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subsections Subsection[]

  @@index([templateId])
}

model Subsection {
  id        String @id @default(uuid())
  sectionId String
  name      String
  order     Int

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  fields  Field[]

  @@index([sectionId])
}

model Field {
  id           String  @id @default(uuid())
  subsectionId String
  name         String
  commentText  String?
  commentType  String
  category     Int?
  answerType   String?
  order        Int

  options         String?
  unitOptions     String?
  recommendation  String?
  defaultValue    String?
  defaultValue2   String?
  defaultUnitType String?

  estimateMin Float?
  estimateMax Float?

  locked        Boolean @default(false)
  simpleFormat  Boolean @default(false)
  disablePhotos Boolean @default(false)
  uses          String?

  subsection Subsection @relation(fields: [subsectionId], references: [id], onDelete: Cascade)
  photos     Photo[]

  @@index([subsectionId])
}

model Photo {
  id      String  @id @default(uuid())
  fieldId String
  url     String
  caption String?

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
}

model ImportIssue {
  id         String  @id @default(uuid())
  templateId String
  sourceRow  Int?
  type       String
  message    String
  sourceData String?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}
